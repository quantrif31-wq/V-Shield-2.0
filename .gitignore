# ----- OS / Editor -----
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# ----- Runtime / logs / temp -----
.runtime/
logs/
*.log
*.pid
tmp/
temp/
.cache/

# ----- Python env / cache / build -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.python-version
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/
pip-wheel-metadata/
build/
dist/
site/
*.egg-info/
.eggs/
*.whl

# ----- Node / frontend build -----
node_modules/
dist-ssr/
.pnpm-store/
.npm/
.yarn/
*.tsbuildinfo

# ----- .NET / C# build -----
.vs/
temp-api-build/
.dotnet/
.dotnet-cli/
.artifacts/
bin/
obj/
TestResults/

# ----- Native / packaged outputs -----
*.exe
*.dll
*.lib
*.so
*.dylib
*.a
*.o
*.obj
*.pkg
*.msi

# ----- Archives / large packaged data -----
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
*.xz
*.iso

# ----- ML datasets / training artifacts -----
runs/
checkpoints/
datasets/
AI_Project/**/runs/
AI_Project/**/weights/
AI_Project/**/checkpoints/
AI_Project/Vietnam License Plate.v2i.yolov8/

# ----- Media and captures not needed for source repo -----
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
*.webp

# Keep training datasets in AI_Project/test tracked (override image ignores above)
!AI_Project/test/dataset/
!AI_Project/test/dataset/**
!AI_Project/test/Indoor Fire Smoke/
!AI_Project/test/Indoor Fire Smoke/**

# ----- Local secrets / machine-specific config -----
.env
API/API/API/appsettings.Production.json
API/API/API/App_Data/
API/API/API/wwwroot/uploads/faces/
runtime/uploads/

# ----- Local tools / bridge binaries -----
AI_Project/cam/go2rtc_win64/
!AI_Project/cam/
!AI_Project/cam/go2rtc_win64/
!AI_Project/cam/go2rtc_win64/go2rtc.exe
!AI_Project/cam/go2rtc_win64/go2rtc.yaml

# Allow go2rtc binary and config regardless of folder (explicit exception)
!**/go2rtc.exe
!**/go2rtc.yaml

# ----- Office documents -----
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx

# macOS archive metadata
__MACOSX/
*.DS_Store
