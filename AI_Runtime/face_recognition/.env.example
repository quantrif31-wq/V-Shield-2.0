# Face Runtime reads process environment variables directly. This file is a
# reference only; it is not loaded automatically.

# Paths may be absolute or relative. Relative paths resolve from repository root.
# When FACE_MODEL_DIR is omitted, the runtime uses:
# API/API/API/wwwroot/uploads/VideoFace/FaceID
FACE_MODEL_DIR=

# Optional/reserved. Current snapshots remain Base64 values in memory and are
# not written to this directory by the current runtime.
FACE_SNAPSHOT_DIR=

FACE_THRESHOLD=0.35
FACE_CONFIRM_FRAMES=5
FACE_LOST_TIMEOUT=2.0
FACE_ENCODE_INTERVAL=0.7
FACE_FRAME_WIDTH=480
FACE_ROTATION=-90
FACE_RECOGNIZE_TIMEOUT=5.0
FACE_ALERT_TIMEOUT=8.0
FACE_STREAM_WIDTH=640
FACE_STREAM_HEIGHT=360
FACE_JPEG_QUALITY=80

# Optional/reserved. Commit 2 does not enforce service-token authentication.
FACE_SERVICE_TOKEN=

# Existing runtime settings, also parsed by the centralized configuration.
PORT=5001
HEADLESS_MODE=1

# All timeout and interval values above are expressed in seconds.
