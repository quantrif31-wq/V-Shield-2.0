MSSQL_SA_PASSWORD=VshieldSqlLocal@2026
VSHIELD_JWT_SECRET=VshieldLocalJwtSecretKey_2026_ChangeMe123
VSHIELD_SEED_ADMIN_USERNAME=admin
VSHIELD_SEED_ADMIN_PASSWORD=AdminLocal@2026
AUTH_DEMO_BYPASS_MFA=false

# URL frontend public cho CORS/API callbacks
APP_FRONTEND_URL=
# URL public go2rtc de render stream.html trong app
APP_GO2RTC_PUBLIC_BASE_URL=
APP_ALLOW_CROSS_ORIGIN_GO2RTC_FRAME=false

# Build-time env cho frontend
VITE_API_BASE_URL=/api
VITE_QR_API_BASE_URL=/qr-api
VITE_PLATE_API_BASE_URL=/plate-api/api

# go2rtc runtime env
GO2RTC_RELOAD_URL=http://go2rtc:1984/api/restart
# De trong => giu logic cu, khong ep candidate.
GO2RTC_WEBRTC_CANDIDATES=
GO2RTC_WEBRTC_PORT=8555
GO2RTC_STREAM_MODE=webrtc
CLOUDFLARED_TUNNEL_TOKEN=

# Service URLs cho API khi o docker mode
PLATE_SERVICE_URL=http://plate-runtime:5002/api
FACE_SERVICE_URL=http://face-runtime:5001/api
# Face Runtime canonical biometric model storage (container path).
FACE_MODEL_DIR=/data/face/models/active
QR_PROXY_BASE=http://qr-runtime:8001
PLATE_PROXY_BASE=http://plate-runtime:5002

# Sync mode cho Docker local:
# - Standalone: local doc lap, mac dinh
# - AreaNode: local dai dien 1 khu vuc va dong bo voi VPS
# Mau cho local khu vuc:
# SYNC_MODE=AreaNode
# SYNC_CENTRAL_BASE_URL=https://vshield.company.vn
# SYNC_REGISTRATION_KEY=ReplaceWithStrongAreaNodeRegistrationKey123!
# SYNC_LOCAL_AREA_NODE_ID=hn-gate-a-lane-1
# SYNC_COMPANY_ID=1
# SYNC_SITE_ID=1
# SYNC_DISPLAY_NAME=HN Gate A Lane 1
# SYNC_ASSIGNED_GATE_IDS=1
# SYNC_ASSIGNED_LANE_IDS=1
# SYNC_ASSIGNED_ZONE_IDS=
# Neu muon local nhan TOAN BO du lieu tu VPS:
# - de trong SYNC_ASSIGNED_GATE_IDS
# - de trong SYNC_ASSIGNED_LANE_IDS
# - de trong SYNC_ASSIGNED_ZONE_IDS
SYNC_MODE=Standalone
SYNC_CENTRAL_BASE_URL=
SYNC_REGISTRATION_KEY=
SYNC_LOCAL_AREA_NODE_ID=
SYNC_COMPANY_ID=
SYNC_SITE_ID=
SYNC_DISPLAY_NAME=
SYNC_VERSION=2.0.0
SYNC_ASSIGNED_GATE_IDS=
SYNC_ASSIGNED_LANE_IDS=
SYNC_ASSIGNED_ZONE_IDS=
SYNC_PUSH_INTERVAL_SECONDS=2
SYNC_PULL_INTERVAL_SECONDS=3
SYNC_BATCH_SIZE=50
SYNC_DOWNSTREAM_SCAN_MULTIPLIER=10
