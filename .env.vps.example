MSSQL_SA_PASSWORD=ReplaceWithAStrongPassword123!
SQL_DATABASE=AccessControlDB
VSHIELD_JWT_SECRET=ReplaceWithAtLeast32CharactersLongSecretKey
JWT_ISSUER=VShieldAPI-VPS
JWT_AUDIENCE=VShieldClient-VPS
VSHIELD_SEED_ADMIN_USERNAME=admin-root
VSHIELD_SEED_ADMIN_PASSWORD=ReplaceWithAStrongAdminPassword123!
VSHIELD_EVIDENCE_EXPORT_SIGNING_KEY=ReplaceWithAnother32CharSigningKeyForEvidence
APP_FRONTEND_URL=https://your-domain.example
APP_FRONTEND_URL_ALT=https://www.your-domain.example
APP_PUBLIC_HOSTNAME=your-domain.example
APP_HTTP_PORT=80
# Self-hosted TURN on the same VPS. TURN_URLS should use a DNS name resolving
# to this VPS (not a Cloudflare HTTP tunnel).
TURN_REALM=your-domain.example
TURN_URLS=turn:your-domain.example:3478?transport=udp,turn:your-domain.example:3478?transport=tcp
TURN_SHARED_SECRET=ReplaceWithLongRandomTurnSharedSecret
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_CREDENTIAL_TTL_SECONDS=3600
DEMO_DATA_ENABLED=true
DEMO_DATA_ALLOW_IN_PRODUCTION=false
AUTH_DEMO_BYPASS_MFA=false
SECURITY_ENABLE_HTTPS_REDIRECTION=false
SECURITY_GATEWAY_HEADERS_MANAGED_BY_PROXY=true
VITE_API_BASE_URL=/api
FACE_SERVICE_URL=http://face-runtime:5001/api
# Face Runtime canonical biometric model storage (container path).
FACE_MODEL_DIR=/data/face/models/active

# VPS trung tam nhan sync tu nhieu local khu vuc
# Moi local phai dung chung SYNC_REGISTRATION_KEY nay khi dang ky node
SYNC_MODE=Central
SYNC_REGISTRATION_KEY=ReplaceWithStrongAreaNodeRegistrationKey123!
SYNC_VERSION=2.0.0
SYNC_PUSH_INTERVAL_SECONDS=2
SYNC_PULL_INTERVAL_SECONDS=3
SYNC_BATCH_SIZE=100
SYNC_DOWNSTREAM_SCAN_MULTIPLIER=20
