{
  "name": "view",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run src/components/ui/__tests__/accessibility.spec.js",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual.spec.js",
    "test:visual:update": "playwright test e2e/visual.spec.js --update-snapshots",
    "test:uat": "node scripts/run-uat.mjs",
    "test:smoke:uat": "node scripts/run-uat.mjs --smoke",
    "test:axe": "playwright test e2e/accessibility.spec.js",
    "security:artifact": "node scripts/scan-production-artifacts.mjs",
    "security:artifacts:all": "node scripts/scan-production-artifacts.mjs && node scripts/scan-sensitive-artifacts.mjs",
    "build:release": "npm run build && npm run security:artifact",
    "design:check": "node scripts/check-design-system.mjs",
    "check": "npm run design:check && npm run test && npm run build",
    "check:release": "npm run design:check && npm run test && npm run build:release && npm run test:e2e"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@microsoft/signalr": "^10.0.0",
    "axios": "^1.13.6",
    "hls.js": "^1.6.15",
    "html5-qrcode": "^2.3.8",
    "jsqr": "^1.4.0",
    "maplibre-gl": "^5.24.0",
    "qrcode": "^1.5.4",
    "three": "^0.185.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
